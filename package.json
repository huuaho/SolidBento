{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:c3dc": "VITE_PROJECT=c3dc vite",
    "dev:gc": "VITE_PROJECT=gc vite",
    "dev:ccdi-hub": "VITE_PROJECT=ccdi-hub vite",
    "build": "npm run build:all",
    "build:all": "npm run build:c3dc && npm run build:gc && npm run build:ccdi-hub && npm run build:landing",
    "build:c3dc": "VITE_PROJECT=c3dc vite build --outDir=dist/c3dc --base=/SolidBento/c3dc/",
    "build:gc": "VITE_PROJECT=gc vite build --outDir=dist/gc --base=/SolidBento/gc/",
    "build:ccdi-hub": "VITE_PROJECT=ccdi-hub vite build --outDir=dist/ccdi-hub --base=/SolidBento/ccdi-hub/",
    "build:landing": "node scripts/create-landing.js",
    "serve": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "gh-pages": "^6.3.0",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "solid-js": "^1.9.9"
  }
}
